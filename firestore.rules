rules_version = '2';

// 업무 커맨드센터 Firestore 보안 규칙
// - users/{내 계정 id} 문서 하나에 대시보드 데이터를 저장합니다.
// - 아래 이메일(내 구글 계정)로 로그인한 본인만 읽고 쓸 수 있어요.
// - 사용법: 아래 YOUR_EMAIL@gmail.com 을 내 구글 이메일로 바꾼 뒤
//   Firebase 콘솔 → Firestore → 규칙(Rules) 에 통째로 붙여넣고 "게시"를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;   // 문서 하나 최대 크기(1MB) 아래로
    }

    // 그 밖의 모든 문서는 아무도 읽고 쓸 수 없음
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == "YOUR_EMAIL@gmail.com"
        && request.auth.token.email_verified == true;
    }
  }
}
